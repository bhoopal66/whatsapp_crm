    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/multimonth": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/rrule": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@mediapipe/tasks-vision": "1.2.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@typesafe-ai/sdk": "0.6.0",
    "@xyflow/react": "^12.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "opus-recorder": "^8.0.5",
    "pdf-lib": "1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.11.0",
    "rrule": "2.8.1",
