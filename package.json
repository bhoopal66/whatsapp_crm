{
  "name": "taamul-connect",
  "version": "0.8.0",
  "private": true,
  "description": "Self-hostable CRM template for WhatsApp built on Next.js and Supabase — shared inbox, contacts, sales pipelines, broadcasts, and no-code automations.",
  "license": "MIT",
  "author": "Arnas Donauskas",
  "keywords": [
    "crm",
    "whatsapp",
    "whapi",
    "nextjs",
    "supabase",
    "automation",
    "broadcast",
    "self-hosted",
    "template"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "predev": "node scripts/copy-meeting-effects.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-meeting-effects.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pbx:gateway": "node scripts/pbx-gateway.mjs"
  },
  "dependencies": {
