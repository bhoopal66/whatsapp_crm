    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
