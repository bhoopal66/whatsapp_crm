    "typescript": "^6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "sharp": "^0.35.3",
    "brace-expansion@^1.0.0": "^1.1.18",
