      ],
      "variables": [
        "customer_name",
        "doc_list"
      ],
      "product": "loan",
      "phoneButton": {
        "label": "Call Taamul",
        "number": "{TAAMUL_DID}"
      }
    },
    "docs_reminder": {
      "category": "UTILITY",
      "buttons": [
        "SENDING_NOW",
        "NEED_MORE_TIME",
        "UPLOAD_HELP",
        "CALL_ME_BACK"
      ],
      "variables": [
        "customer_name",
        "doc_list"
      ],
      "product": null
    },
    "pos_application_status": {
      "category": "UTILITY",
      "buttons": [],
      "variables": [
        "customer_name",
        "application_ref"
      ],
      "product": "pos",
      "phoneButton": {
        "label": "Call Taamul",
        "number": "{TAAMUL_DID}"
      }
    },
    "loan_application_status": {
      "category": "UTILITY",
      "buttons": [],
      "variables": [
        "customer_name",
        "application_ref"
      ],
      "product": "loan",
      "phoneButton": {
        "label": "Call Taamul",
        "number": "{TAAMUL_DID}"
      }
    },
    "acct_bank_matched": {
      "category": "UTILITY",
