      ],
      "variables": [
        "customer_name",
        "doc_list"
      ],
      "product": "acct",
      "phoneButton": {
        "label": "Call Taamul",
        "number": "{TAAMUL_DID}"
      }
    },
    "loan_docs_request": {
      "category": "UTILITY",
      "buttons": [
        "UPLOAD_HELP",
