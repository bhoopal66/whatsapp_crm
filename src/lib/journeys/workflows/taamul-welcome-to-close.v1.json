      ],
      "variables": [
        "customer_name"
      ],
      "product": "acct"
    },
    "loan_pitch_in_window": {
      "category": "SESSION",
      "buttons": [
        "CHECK_ELIGIBILITY",
        "NOT_NOW",
        "CALL_ME_BACK"
      ],
      "variables": [
        "customer_name"
      ],
      "product": "loan"
    },
    "loan_intro_offer": {
      "category": "MARKETING",
      "buttons": [
        "CHECK_ELIGIBILITY",
        "NOT_NOW",
        "CALL_ME_BACK"
      ],
      "variables": [
        "customer_name"
      ],
      "product": "loan"
    },
    "acct_eligibility_prescreen": {
      "category": "UTILITY",
      "buttons": [
        "CALL_ME_BACK"
      ],
      "variables": [
        "customer_name"
      ],
      "product": "acct"
    },
    "loan_eligibility_prescreen": {
      "category": "UTILITY",
      "buttons": [
        "CALL_ME_BACK"
      ],
      "variables": [
        "customer_name"
      ],
      "product": "loan"
    },
    "pos_docs_request": {
      "category": "UTILITY",
      "buttons": [
        "UPLOAD_HELP",
