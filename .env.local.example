# ============================================================
# REQUIRED — the app won't start without these.
# ============================================================

# Supabase (Project Settings → API)
#
# NEXT_PUBLIC_SUPABASE_URL is BROWSER-FACING — it is baked into the
# client bundle and fetched from the visitor's machine. On a hosted
# Supabase project that's the project URL and there is nothing more to
# think about.
#
# On a SELF-HOSTED Supabase it must NOT be http://localhost:8000:
# `localhost` is the visitor's own computer, and an http:// call from
# an https:// page is blocked as mixed content anyway. The symptom is
# a bare "Failed to fetch" on login. Put Supabase behind the same
# public HTTPS origin as the app (see docs/self-hosting-supabase.md)
# and point this at that address.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Server-side route to Supabase, used by every server
# component, API route and the middleware. Defaults to
# NEXT_PUBLIC_SUPABASE_URL when unset — which is correct for hosted
# Supabase, so most installs can ignore this.
#
# Set it when the server can reach Supabase more directly than the
# browser can (self-hosted on the same box, or a container network).
# Two reasons it matters: server queries otherwise take a pointless
# round-trip out to the public origin and back, and every server-side
# query would depend on the reverse proxy / tunnel staying up.
# SUPABASE_INTERNAL_URL=http://localhost:8000

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path — see docs/public-api.md). Keep this secret — never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings → API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts the Whapi channel token AND the per-channel webhook secret.
# Rotating this value orphans both — users have to re-save their
# WhatsApp settings in the dashboard to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# ============================================================
# RECOMMENDED — safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash).
#
# ── Effectively REQUIRED for inbound WhatsApp messages ──
# This is the origin written into the callback URL registered on your
# Whapi channel. Whapi refuses to deliver to anything but HTTPS, and a
# wrong value here means outbound sending works while nothing your
# customers write ever arrives — the least obvious way for this app to
# be broken.
#
# If this box isn't directly reachable on the public internet, put a
# tunnel in front of it and use the tunnel's hostname:
#   cloudflared tunnel --url http://localhost:3000
#   ngrok http 3000
#
# It is also used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations)
# fall back to the request's own Host header when this is unset.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL — only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions — the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron, GET /api/flows/cron
# and GET /api/whatsapp/broadcast/cron. Required if you use Wait steps
# in automations, flows, or scheduled broadcasts (a scheduled pinger
# drains pending work). Generate any long random string:
#   openssl rand -hex 32
# See docs/docker.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# ------------------------------------------------------------------
# Whapi.Cloud (the WhatsApp gateway)
# ------------------------------------------------------------------
# There is NO global Whapi credential. Each account pastes its own
# channel token under Settings → WhatsApp; it is stored AES-256-GCM
# encrypted with ENCRYPTION_KEY (above). The two vars below only
# matter if you are not using Whapi's public gateway.

# Gateway base URL. Override only for a self-hosted / on-prem Whapi
# deployment, or to point tests at a local stub.
# WHAPI_BASE_URL=https://gate.whapi.cloud

# Per-request timeout for Whapi calls, in milliseconds. Default 30000.
# WHAPI_TIMEOUT_MS=30000

# Host of Whapi's Safety Meter, which Team activity reads for each
# Whapi number's restriction-risk rating. Override only for a stub.
# WHAPI_TOOLS_URL=https://tools.whapi.cloud

# ------------------------------------------------------------------
# Meta WhatsApp Cloud API (optional second number)
# ------------------------------------------------------------------
# An account can connect a Meta Cloud API number ALONGSIDE its Whapi
# channel and route each kind of message to one or the other
# (Settings → WhatsApp). See docs/meta-cloud-api.md.
#
# It must be a DIFFERENT phone number: a Whapi channel pairs to a
# number that still lives in the WhatsApp app, and registering a number
# on the Cloud API removes it from the app.
#
# As with Whapi there is no global credential — the phone number id,
# WABA id and access token are pasted per account and stored
# AES-256-GCM encrypted with ENCRYPTION_KEY (above). The two vars below
# are a convenience for a SINGLE-APP self-host that would rather
# configure the app-level secrets once here than per account.

# App Secret (Meta → App Settings → Basic). Verifies the
# X-Hub-Signature-256 on inbound webhooks. A per-account value saved in
# Settings wins over this. With neither set, inbound Meta callbacks are
# rejected — verification fails CLOSED.
# META_APP_SECRET=your-meta-app-secret

# The token echoed during Meta's webhook subscription handshake. Any
# string; paste the same value into the App dashboard. A per-account
# value saved in Settings wins over this.
# META_VERIFY_TOKEN=any-string-you-choose

# Graph API version. Meta deprecates versions on a ~2-year clock, so
# this is overridable without waiting on a release. Default v23.0.
# META_API_VERSION=v23.0

# Per-request timeout for Graph calls, in milliseconds. Default 30000.
# META_TIMEOUT_MS=30000

# Timezone that decides which calendar month a delivery belongs to for
# the message-cost ledger (Settings → Message costs): the free tier of
# 1,000 service messages per number resets monthly in the WhatsApp
# Business Account's timezone. Default Asia/Dubai. See docs/meta-cloud-api.md.
# WHATSAPP_BILLING_TIMEZONE=Asia/Dubai

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings → AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) — there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension — migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) — plus a per-account embeddings key set in
# Settings → AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20

# ------------------------------------------------------------------
# TypeSafe decision layer for the AI bot (optional — docs/typesafe.md)
# ------------------------------------------------------------------
# Needs migrations 063 and 064. With the two secrets below, each
# account switches the layer on and off itself in Settings -> AI safety
# checks (monitor only, or live). Without them it is unavailable. The
# other variables are optional install-wide overrides no account can
# undo. An invalid value turns the whole layer OFF (the bot answers as
# it did before) and says so in the service log and in the Settings
# panel — grep '[ts013]' after every change. No inline comments on these
# lines: systemd's EnvironmentFile keeps "TS_SHADOW=true # note" as the
# value "true # note".

# Server-side secret.
# TYPESAFE_API_KEY=

# Server-side secret, at least 32 characters (openssl rand -hex 32).
# Required with the key: keys the hashes of logged state and message
# ids, so a short message like "stop" can't be recovered.
# TS_LOG_HASH_KEY=

# Optional allowlist: comma-separated account ids. Unset = any account
# may switch the layer on; others' customer text is never sent.
# TS_ACCOUNT_IDS=

# Pinned model (jev-X.Y.Z); thresholds are only valid for this exact
# id. Aliases (jev-latest, jev-preview) and two-part versions are refused.
# TYPESAFE_MODEL=jev-1.13.0

# Take a check away from every account (each defaults to available
# when the key is set).
# TS_ENABLED_TRIAGE=false
# TS_ENABLED_PASSAGES=false
# TS_ENABLED_GUARDRAIL=false
# TS_ENABLED_ELIGIBILITY=false

# Force monitor-only (log, never act) on every account. Default false.
# Per-check overrides: TS_SHADOW_TRIAGE / _PASSAGES / _GUARDRAIL / _ELIGIBILITY.
# TS_SHADOW=true

# Languages held back (logged only) for accounts that chose "English
# only". Default ar,mixed,other ("other" = any script besides Arabic
# and Latin); "none" clears.
# TS_SHADOW_LANGUAGES=ar,mixed,other

# Per-attempt timeouts in ms (one retry), 1–10000. Defaults 2500 / 3000.
# TS_TIMEOUT_MS=2500
# TS_GUARDRAIL_TIMEOUT_MS=3000

# What the guardrail does with a reply when it cannot screen it
# (TypeSafe down while the guardrail is live): hold (default) or send.
# TS_GUARDRAIL_FAIL_MODE=hold

# The SDK's own TYPESAFE_BASE_URL, TYPESAFE_LOG_LEVEL and
# TYPESAFE_DEFAULT_MODEL are ignored: the layer pins the endpoint
# (https://api.typesafe.ai), the log level (warn) and the model.

# ---- Edge security (webhook screening, login lockout) ----------------
# Which request header carries the real client IP. Unset = no trusted
# header: every caller shares one "unknown" bucket for the per-IP limits.
# Behind a Cloudflare tunnel use cf-connecting-ip; behind your own proxy
# use x-forwarded-for together with EDGE_TRUSTED_PROXY_HOPS. Never trust
# the left-most X-Forwarded-For entry: the client writes it.
# EDGE_CLIENT_IP_HEADER=cf-connecting-ip
# For x-forwarded-for only: how many proxies you run in front of the app
# (the address is taken that many entries from the right). Default 1.
# EDGE_TRUSTED_PROXY_HOPS=1
