# The base URL of your Taamul Connect instance (no trailing slash).
TAAMUL_BASE_URL=https://your-crm.example.com

# A Taamul Connect API key. Create one in the dashboard:
#   Settings → API keys → New key
# The key's scopes decide what the MCP tools are allowed to do.
TAAMUL_API_KEY=taamul_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Both variables are also read under their pre-rebrand names
# (WACRM_BASE_URL, WACRM_API_KEY, …), so an existing MCP client
# config keeps working without edits. New setups should use TAAMUL_*.

# Read-only by default: the write tools (contact create/update,
# message send) are not even registered unless you opt in here.
# TAAMUL_ENABLE_WRITES=true

# The mass-broadcast tool is gated separately — it needs
# TAAMUL_ENABLE_WRITES as well.
# TAAMUL_ENABLE_BROADCASTS=true
